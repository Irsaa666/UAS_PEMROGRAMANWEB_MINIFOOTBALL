# Mini Football Manager - .gitignore

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
env/
.venv/
.env/

# Environment variables (contains secrets)
.env

# Uploaded user files (not committed to git)
uploads/*
!uploads/.gitkeep

# IDE files
.vscode/
.idea/
*.swp

# OS Files
.DS_Store
Thumbs.db

# Vercel
.vercel/
